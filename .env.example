# STT
CONSPECTOR_STT_MODE=real
CONSPECTOR_STT_PYTHON=/Users/you/abi_conspector/.venv-stt/bin/python
CONSPECTOR_STT_SCRIPT=/Users/you/abi_conspector/scripts/run_stt_diarization.py
CONSPECTOR_WHISPER_MODEL=medium
CONSPECTOR_STT_LANGUAGE=ru
CONSPECTOR_STT_DEVICE=cpu
CONSPECTOR_STT_COMPUTE_TYPE=int8
CONSPECTOR_STT_BATCH_SIZE=8
CONSPECTOR_STT_TIMEOUT_SEC=1800
CONSPECTOR_REQUIRE_DIARIZATION=true
HUGGINGFACE_TOKEN=
CONSPECTOR_STT_FALLBACK_TO_MOCK=true
CONSPECTOR_MIC_DEVICE_INDEX=

# Codex workers
CONSPECTOR_CODEX_MODE=real
CONSPECTOR_CODEX_FULL_AUTO=true
CONSPECTOR_CODEX_MODEL=
CONSPECTOR_CODEX_EFFORT=medium
CONSPECTOR_CODEX_TIMEOUT_SEC=600
CONSPECTOR_CODEX_WORKDIR=/Users/you/abi_conspector
CONSPECTOR_SOURCE_NOTE_PATH=
CONSPECTOR_CODEX_FALLBACK_TO_MOCK=true

# Notion (optional)
CONSPECTOR_NOTION_MODE=off
NOTION_TOKEN=
CONSPECTOR_NOTION_PAGE_ID=
CONSPECTOR_NOTION_PAGE_TITLE=
CONSPECTOR_NOTION_SOFT_FAIL=true

# Resilience
CONSPECTOR_HTML_SOFT_FAIL=true
CONSPECTOR_PREFLIGHT_STRICT=false
