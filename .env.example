# STT
CONSPECTOR_STT_MODE=real
CONSPECTOR_STT_PRIMARY=groq
CONSPECTOR_STT_FALLBACK=whispercpp
CONSPECTOR_STT_TIMEOUT_SEC=1800
CONSPECTOR_STT_LANGUAGE=ru
CONSPECTOR_WHISPER_MODEL=base

# Groq STT (primary)
CONSPECTOR_GROQ_API_KEY=
CONSPECTOR_GROQ_MODEL=whisper-large-v3-turbo
CONSPECTOR_GROQ_MAX_FILE_MB=25
CONSPECTOR_GROQ_CHUNK_MIN=18

# whisper.cpp (fallback or local primary)
CONSPECTOR_WHISPERCPP_BIN=/Users/you/abi_conspector/tools/whisper.cpp/build/bin/whisper-cli
CONSPECTOR_WHISPERCPP_MODEL_PATH=/Users/you/abi_conspector/models/ggml-base.bin
CONSPECTOR_WHISPERCPP_THREADS=2

# Legacy STT env (kept for compatibility; not used in v3 pipeline)
CONSPECTOR_STT_PYTHON=/Users/you/abi_conspector/.venv-stt/bin/python
CONSPECTOR_STT_SCRIPT=/Users/you/abi_conspector/scripts/run_stt_diarization.py
CONSPECTOR_STT_DEVICE=cpu
CONSPECTOR_STT_COMPUTE_TYPE=int8
CONSPECTOR_STT_BATCH_SIZE=8
CONSPECTOR_REQUIRE_DIARIZATION=false
HUGGINGFACE_TOKEN=

# Codex workers
CONSPECTOR_CODEX_MODE=real
CONSPECTOR_CODEX_FULL_AUTO=true
CONSPECTOR_CODEX_MODEL=
CONSPECTOR_CODEX_EFFORT=medium
CONSPECTOR_CODEX_TIMEOUT_SEC=600
CONSPECTOR_CODEX_WORKDIR=/Users/you/abi_conspector
CONSPECTOR_SOURCE_NOTE_PATH=
CONSPECTOR_CODEX_FALLBACK_TO_MOCK=true

# Notion
CONSPECTOR_NOTION_MODE=off
NOTION_TOKEN=
# Optional direct target (usually empty when using manual title in UI)
CONSPECTOR_NOTION_PAGE_ID=
CONSPECTOR_NOTION_PAGE_TITLE=
CONSPECTOR_NOTION_ROOT_PAGE_ID=
CONSPECTOR_NOTION_MERGE_WITH_EXISTING=true
CONSPECTOR_NOTION_SOFT_FAIL=true

# Web mode (accounts / roles / shared view)
CONSPECTOR_WEB_PORT=8787
CONSPECTOR_WEB_DB_PATH=
CONSPECTOR_WEB_SESSION_DAYS=30
CONSPECTOR_ADMIN_EMAILS=

# Resilience
CONSPECTOR_STT_FALLBACK_TO_MOCK=false
CONSPECTOR_HTML_SOFT_FAIL=true
CONSPECTOR_PREFLIGHT_STRICT=false
